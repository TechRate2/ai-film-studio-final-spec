{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectiveCapability",
  "type": "object",
  "required": [
    "capability",
    "status",
    "model_status",
    "provider_status",
    "resolution",
    "account_entitlement",
    "product_policy",
    "project_policy"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED",
        "UNKNOWN",
        "DEGRADED"
      ]
    },
    "model_status": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "source_version",
        "evidence_ids",
        "constraints"
      ],
      "additionalProperties": false
    },
    "provider_status": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "source_version",
        "evidence_ids",
        "constraints"
      ],
      "additionalProperties": false
    },
    "account_entitlement": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "source_version",
        "evidence_ids",
        "constraints"
      ],
      "additionalProperties": false
    },
    "product_policy": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "source_version",
        "evidence_ids",
        "constraints"
      ],
      "additionalProperties": false
    },
    "project_policy": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "source_version",
        "evidence_ids",
        "constraints"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "degrade_decision_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "model_status": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "provider_status": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "account_entitlement": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "product_policy": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "project_policy": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "model_status": {
                "properties": {
                  "status": {
                    "const": "UNSUPPORTED"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "provider_status": {
                "properties": {
                  "status": {
                    "const": "UNSUPPORTED"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "account_entitlement": {
                "properties": {
                  "status": {
                    "const": "UNSUPPORTED"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "product_policy": {
                "properties": {
                  "status": {
                    "const": "UNSUPPORTED"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "project_policy": {
                "properties": {
                  "status": {
                    "const": "UNSUPPORTED"
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "UNSUPPORTED",
              "DEGRADED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEGRADED"
          }
        }
      },
      "then": {
        "required": [
          "degrade_decision_id"
        ],
        "properties": {
          "degrade_decision_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
