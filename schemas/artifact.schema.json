{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "currency",
    "provenance",
    "project_id",
    "version_id",
    "acceptance",
    "content_hash",
    "storage_key"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/artifact_currency"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "INTERNAL_GENERATED",
            "EXTERNAL_IMPORTED",
            "DETERMINISTIC_DERIVED",
            "PENDING",
            "DIRECTOR_AUTHORED"
          ]
        },
        "source_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "uploader_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rights_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "external_tool": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "external_cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "input_versions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source_pin"
          },
          "minItems": 0
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authorization_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "spec_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "profile_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "compiler_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "request_snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prompt_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reference_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "result_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "qa_report_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "source_label",
        "source_uri",
        "source_hash",
        "uploader_id",
        "rights_refs",
        "external_tool",
        "external_cost",
        "input_versions",
        "attempt_id",
        "authorization_id",
        "spec_version",
        "profile_versions",
        "compiler_version",
        "request_snapshot_id",
        "prompt_hash",
        "reference_hash",
        "result_hash",
        "qa_report_id",
        "cost",
        "currency",
        "created_at",
        "provider_id",
        "model_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "INTERNAL_GENERATED"
              }
            }
          },
          "then": {
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "authorization_id": {
                "type": "string",
                "minLength": 1
              },
              "spec_version": {
                "type": "string",
                "minLength": 1
              },
              "compiler_version": {
                "type": "string",
                "minLength": 1
              },
              "request_snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "prompt_hash": {
                "type": "string",
                "minLength": 1
              },
              "reference_hash": {
                "type": "string",
                "minLength": 1
              },
              "result_hash": {
                "type": "string",
                "minLength": 1
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "EXTERNAL_IMPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "source_label": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "minLength": 1
              },
              "uploader_id": {
                "type": "string",
                "minLength": 1
              },
              "result_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "DETERMINISTIC_DERIVED"
              }
            }
          },
          "then": {
            "properties": {
              "compiler_version": {
                "type": "string",
                "minLength": 1
              },
              "result_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "enum": [
        "UNREVIEWED",
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "storage_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "acceptance": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": {
                "not": {
                  "const": "PENDING"
                }
              },
              "qa_report_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
