{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePack",
  "type": "object",
  "required": [
    "facts",
    "best_practices",
    "model_capabilities",
    "prompt_tactics",
    "failure_risks",
    "provenance",
    "pack_id",
    "project_id",
    "version",
    "claim_links"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "CONFLICTED",
              "UNKNOWN"
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "claim",
          "confidence",
          "evidence_ids",
          "status",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "best_practices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_tactics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "successful_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicting_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "research_evidence.schema.json"
      },
      "minItems": 0
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "claim_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "section",
          "index",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
