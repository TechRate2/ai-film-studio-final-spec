{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePack",
  "type": "object",
  "required": ["facts","best_practices","model_capabilities","prompt_tactics","failure_risks","provenance"],
  "properties": {
    "facts": {"type":"array","items":{"type":"object","required":["claim","confidence"],"properties":{"claim":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "best_practices": {"type":"array","items":{"type":"string"}},
    "model_capabilities": {"type":"array","items":{"type":"string"}},
    "prompt_tactics": {"type":"array","items":{"type":"string"}},
    "failure_risks": {"type":"array","items":{"type":"string"}},
    "successful_patterns": {"type":"array","items":{"type":"string"}},
    "conflicting_findings": {"type":"array","items":{"type":"string"}},
    "provenance": {"type":"array","items":{"type":"object","properties":{"source":{"type":"string"},"evidence_label":{"type":"string"},"verified_at":{"type":["string","null"]}}}}
  }
}
