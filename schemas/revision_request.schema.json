{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RevisionRequest",
  "type": "object",
  "required": [
    "shot_id",
    "base_version_id",
    "user_intent",
    "change_set",
    "preserve_set",
    "revision_id",
    "project_id",
    "edit_class",
    "source_versions",
    "incoming_baton_ids",
    "outgoing_required_versions",
    "affected_modalities",
    "estimated_incremental_cost"
  ],
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "base_version_id": {
      "type": "string"
    },
    "user_intent": {
      "type": "string"
    },
    "edit_class": {
      "enum": [
        "TEXT",
        "SUBTITLE",
        "VOICE",
        "MIX",
        "TIMELINE",
        "POSTPROCESS",
        "VIDEO",
        "REFERENCE_VIDEO",
        "KEYFRAME_VIDEO",
        "CANON"
      ]
    },
    "change_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preserve_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incoming_baton_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outgoing_target_shot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_modalities": {
      "type": "array",
      "items": {
        "enum": [
          "TEXT",
          "SUBTITLE",
          "VOICE",
          "MIX",
          "TIMELINE",
          "IMAGE",
          "VIDEO",
          "CANON"
        ]
      },
      "minItems": 0
    },
    "estimated_incremental_cost": {
      "type": "number",
      "minimum": 0
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source_pin"
      },
      "minItems": 0
    },
    "incoming_baton_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "outgoing_required_versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/version_ref"
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
