{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DurableJob",
  "type": "object",
  "required": [
    "job_id",
    "project_id",
    "job_type",
    "status",
    "dependencies",
    "created_at",
    "updated_at",
    "run_id",
    "revision",
    "input_versions"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "job_type": {
      "type": "string"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/job_status"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "completed",
        "total",
        "message"
      ],
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lease_token": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source_pin"
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
