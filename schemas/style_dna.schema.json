{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyleDNA",
  "type": "object",
  "required": [
    "style_dna_id",
    "source_artifact_ids",
    "transferable_traits",
    "do_not_copy_elements",
    "source_versions",
    "version",
    "confidence"
  ],
  "properties": {
    "style_dna_id": {
      "type": "string"
    },
    "source_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrative_structure": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "hook_pattern": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "emotional_curve": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "pacing_profile": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "shot_scale_distribution": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "camera_movement_profile": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "lens_feel": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "composition_rules": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "lighting_color": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "performance_density": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "transition_language": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "audio_hierarchy": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "realism_vfx": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "transferable_traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_copy_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source_pin"
      },
      "minItems": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
