{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeEvidenceGraph",
  "type": "object",
  "required": [
    "graph_id",
    "nodes",
    "edges",
    "project_id",
    "version"
  ],
  "properties": {
    "graph_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "AUDIENCE",
              "CONTEXT",
              "MECHANISM",
              "CREATIVE_CHOICE",
              "OUTCOME",
              "EVIDENCE"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "resource_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "outcome_kind": {
                "enum": [
                  "EXPECTED",
                  "OBSERVED",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "description",
              "resource_ids",
              "outcome_kind"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation",
          "confidence"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "common.schema.json#/$defs/scope"
          }
        },
        "additionalProperties": false
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
