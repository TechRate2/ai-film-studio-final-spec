{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceProfile",
  "type": "object",
  "required": [
    "voice_profile_id",
    "speaker_id",
    "identity",
    "language_capabilities",
    "pronunciation_lexicon",
    "project_id",
    "version",
    "consent_refs"
  ],
  "properties": {
    "voice_profile_id": {
      "type": "string"
    },
    "speaker_id": {
      "type": "string"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "provider_voice_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_audio_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pace": {
      "type": [
        "string",
        "null"
      ]
    },
    "pitch": {
      "type": [
        "string",
        "null"
      ]
    },
    "accent": {
      "type": [
        "string",
        "null"
      ]
    },
    "emotion_range": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pronunciation_lexicon": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation": {
            "type": "string",
            "minLength": 1
          },
          "source_line_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "language",
          "pronunciation",
          "source_line_ids"
        ],
        "additionalProperties": false
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "consent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
