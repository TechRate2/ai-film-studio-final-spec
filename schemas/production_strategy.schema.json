{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionStrategy",
  "type": "object",
  "required": [
    "strategy_id",
    "objective",
    "routes",
    "cost_rationale",
    "project_id",
    "version"
  ],
  "properties": {
    "strategy_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope_id",
          "mode",
          "reason"
        ],
        "properties": {
          "scope_id": {
            "type": "string"
          },
          "mode": {
            "$ref": "common.schema.json#/$defs/generation_mode"
          },
          "reason": {
            "type": "string"
          },
          "quality_risk": {
            "$ref": "common.schema.json#/$defs/risk"
          },
          "estimated_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "cost_rationale": {
      "type": "string"
    },
    "mixed_media_allowed": {
      "type": "boolean"
    },
    "constraints": {
      "$ref": "common.schema.json#/$defs/constraints"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
