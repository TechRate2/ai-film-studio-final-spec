{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyframeGenerationPack",
  "type": "object",
  "required": [
    "keyframe_id",
    "purpose",
    "target_shot_or_segment",
    "source_strategy",
    "project_id",
    "target_version_id"
  ],
  "properties": {
    "keyframe_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "target_shot_or_segment": {
      "type": "string"
    },
    "source_strategy": {
      "enum": [
        "AUTO_INTERNAL",
        "EXTERNAL_ASSISTED",
        "USER_SUPPLIED",
        "PREVIOUS_ACCEPTED_FRAME",
        "NONE"
      ]
    },
    "model_neutral_prompt": {
      "type": "string"
    },
    "reference_bindings": {
      "type": "array",
      "items": {
        "$ref": "reference_binding.schema.json"
      },
      "minItems": 0
    },
    "continuity_locks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "aspect_ratio": {
      "type": [
        "string",
        "null"
      ]
    },
    "success_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correction_patch": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "target_version_id": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "string",
      "minLength": 1
    },
    "camera": {
      "$ref": "common.schema.json#/$defs/camera"
    },
    "lighting": {
      "type": "string",
      "minLength": 1
    },
    "negative_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "source_versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source_pin"
      },
      "minItems": 0
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_strategy": {
            "not": {
              "const": "NONE"
            }
          }
        }
      },
      "then": {
        "required": [
          "keyframe_id",
          "purpose",
          "target_shot_or_segment",
          "source_strategy",
          "model_neutral_prompt",
          "reference_bindings",
          "success_conditions",
          "project_id",
          "target_version_id",
          "composition",
          "camera",
          "lighting",
          "negative_risks",
          "continuity_locks",
          "source_versions"
        ],
        "properties": {
          "model_neutral_prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "model_neutral_prompt": {
            "const": ""
          },
          "reference_bindings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
