        "valid_until_story_position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "correction_proposition_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
