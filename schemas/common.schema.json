    "claim": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "evidence_label": {
          "enum": [
            "VERIFIED_SOURCE",
            "REPO_REPORTED",
            "PRODUCT_OBSERVED",
            "SYNTHESIS",
            "UNVERIFIED"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider_scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "last_verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "known_failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sample_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "value",
        "evidence_label",
        "source",
        "source_version",
        "model_version",
        "provider_scope",
        "last_verified_at",
        "sample_count",
        "confidence",
        "known_failures",
        "unknowns"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUPPORTED",
                  "UNSUPPORTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_label": {
                "enum": [
                  "VERIFIED_SOURCE",
                  "PRODUCT_OBSERVED"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "string",
                "minLength": 1
              },
              "provider_scope": {
                "type": "string",
                "minLength": 1
              },
              "last_verified_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_label": {
                "const": "PRODUCT_OBSERVED"
              }
            }
          },
          "then": {
            "required": [
              "sample_refs"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "string",
                "minLength": 1
              },
              "provider_scope": {
                "type": "string",
                "minLength": 1
              },
              "last_verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "sample_count": {
                "minimum": 1
              },
              "sample_refs": {
                "minItems": 1,
                "uniqueItems": true
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "route_policy": {
      "type": "object",
      "properties": {
        "provider_ids": {
          "type": "array",
