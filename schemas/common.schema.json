        "route": {
          "enum": [
            "NONE",
            "NATIVE",
            "CONTROLLED_POST",
            "REFERENCE_AUDIO",
            "SPEECH_TO_VIDEO",
            "HYBRID"
          ]
        },
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "dialogue_scene.schema.json"
          },
          "minItems": 0
        },
        "ambience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "foley": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
