        "entry_id",
        "proposition_id",
        "stance",
        "acquisition_event_id",
        "valid_from_story_position",
        "valid_until_story_position",
        "source_version",
        "correction_proposition_id"
      ],
      "additionalProperties": false
    },
    "json_value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
