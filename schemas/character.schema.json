{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character",
  "type": "object",
  "required": [
    "character_id",
    "name",
    "aliases",
    "canonical_reference_ids",
    "knowledge_state",
    "project_id",
    "version",
    "knowledge_entries"
  ],
  "properties": {
    "character_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_appearance": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "current_state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "voice_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledge_state": {
      "type": "object",
      "required": [
        "knows",
        "believes",
        "suspects",
        "misunderstands",
        "hides",
        "wants",
        "fears"
      ],
      "properties": {
        "knows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "believes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suspects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misunderstands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fears": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "knowledge_entries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/knowledge"
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
