{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DialogueScene",
  "type": "object",
  "required": [
    "speaker_id",
    "line",
    "intent",
    "emotion",
    "line_id",
    "language",
    "knowledge_entry_ids"
  ],
  "properties": {
    "speaker_id": {
      "type": "string"
    },
    "listener_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "line": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "emotion": {
      "type": "string"
    },
    "subtext": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "pace": {
      "type": "string"
    },
    "pause_after_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "eyeline_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocking": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "pronunciation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "line_id": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
