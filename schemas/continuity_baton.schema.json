    "props": {"type":"array","items":{"type":"object","properties":{"prop_id":{"type":"string"},"state":{"type":"string"}}}},
    "location": {"type":["string","null"]},
    "lighting": {"type":["string","null"]},
    "time": {"type":["string","null"]},
    "story_state": {"type":"object"},
    "music_state": {"type":["string","null"]},
    "ambience": {"type":["string","null"]},
