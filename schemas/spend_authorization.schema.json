{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpendAuthorization",
  "type": "object",
  "required": [
    "authorization_id",
    "project_id",
    "status",
    "hard_cap",
    "allowed_attempts",
    "run_id",
    "plan_version",
    "plan_hash",
    "currency",
    "estimated_total",
    "consumed_cost",
    "reserved_cost",
    "created_by_user_action",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "authorization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "AUTHORIZED",
        "EXHAUSTED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "hard_cap": {
      "type": "number",
      "minimum": 0
    },
    "estimated_total": {
      "type": "number",
      "minimum": 0
    },
    "allowed_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "logical_attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_or_scope_id": {
            "type": "string",
            "minLength": 1
          },
          "target_version_id": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "enum": [
              "IMAGE",
              "VIDEO",
              "VOICE",
              "LIP_SYNC",
              "GENERATIVE_REPAIR",
              "PROBE"
            ]
          },
          "provider_policy": {
            "$ref": "common.schema.json#/$defs/route_policy"
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "max_cost": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "logical_attempt_id",
          "artifact_or_scope_id",
          "target_version_id",
          "modality",
          "provider_policy",
          "candidate_count",
          "max_cost"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "consumed_cost": {
      "type": "number",
      "minimum": 0
    },
    "created_by_user_action": {
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_version": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "reserved_cost": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
