{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceBinding",
  "type": "object",
  "required": [
    "reference_id",
    "role",
    "lock_mode",
    "lifetime",
    "positive_scope",
    "negative_scope",
    "source_artifact_id",
    "source_version_id",
    "project_id",
    "target_scope_id",
    "entity_id"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "anyOf": [
        {
          "enum": [
            "CHARACTER_IDENTITY",
            "CHARACTER_OUTFIT",
            "PRODUCT_FRONT",
            "PRODUCT_SIDE",
            "PRODUCT_DETAIL",
            "PROP_IDENTITY",
            "LOCATION",
            "CAMERA_REFERENCE",
            "EDITING_PACING_REFERENCE",
            "STYLE_REFERENCE",
            "MOTION_REFERENCE",
            "VOICE_REFERENCE",
            "MUSIC_REFERENCE",
            "SFX_REFERENCE",
            "STORY_STRUCTURE_REFERENCE",
            "SCRIPT_SOURCE",
            "FACT_SOURCE",
            "BRAND_GUIDELINE"
          ]
        },
        {
          "type": "string",
          "pattern": "^X_[A-Z0-9_]+$"
        }
      ]
    },
    "lock_mode": {
      "enum": [
        "HARD_LOCK",
        "SOFT_LOCK",
        "STYLE_ONLY",
        "MOTION_ONLY"
      ]
    },
    "lifetime": {
      "enum": [
        "PERSISTENT",
        "EPISODE",
        "SCENE",
        "SHOT"
      ]
    },
    "positive_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "negative_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifact_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1
    },
    "target_scope_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
