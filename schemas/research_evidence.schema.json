{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchEvidence",
  "type": "object",
  "required": [
    "evidence_id",
    "claim",
    "source",
    "evidence_label",
    "confidence",
    "verified_at",
    "scope",
    "source_version",
    "retrieved_at",
    "sample_count",
    "verification_method"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "evidence_label": {
      "enum": [
        "VERIFIED_SOURCE",
        "REPO_REPORTED",
        "PRODUCT_OBSERVED",
        "SYNTHESIS",
        "UNVERIFIED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
