{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ResearchEvidence",
  "type":"object",
  "required":["evidence_id","claim","source","evidence_label","confidence","verified_at","scope"],
  "properties":{
    "evidence_id":{"type":"string"},"claim":{"type":"string"},"source":{"type":"string"},"evidence_label":{"enum":["VERIFIED_SOURCE","REPO_REPORTED","PRODUCT_OBSERVED","SYNTHESIS","UNVERIFIED"]},"confidence":{"type":"number","minimum":0,"maximum":1},"verified_at":{"type":["string","null"]},"scope":{"type":"object"},"contradicts":{"type":"array","items":{"type":"string"}},"expires_at":{"type":["string","null"]}
  }
}
