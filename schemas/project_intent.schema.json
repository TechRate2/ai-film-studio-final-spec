{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectIntent",
  "type": "object",
  "required": [
    "project_id",
    "user_request",
    "objective",
    "constraints"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "user_request": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "target_audience": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_target_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "aspect_ratio": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "constraints": {
      "$ref": "common.schema.json#/$defs/constraints"
    },
    "attachment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ui_locale": {
      "enum": [
        "vi",
        "en"
      ]
    }
  },
  "additionalProperties": false
}
